# Copy to .env and fill in. .env is gitignored and must never be committed.

# PostgreSQL connection URL.
#
# The application requires the asyncpg driver (design.md Decision 1). A bare
# postgresql:// URL -- what managed providers hand out -- is normalized to
# postgresql+asyncpg:// automatically, so either form works here.
#
# Local development uses the Postgres container in docker-compose.yml
# (`docker compose up -d`); deployment points this at a managed instance instead.
DATABASE_URL=postgresql+asyncpg://nutrition:nutrition@localhost:5432/nutrition

# Database the test suite binds to. Deliberately a separate setting rather than derived
# from DATABASE_URL: the fixtures create and drop the schema, and must never be able to
# do that to development data. The compose file creates this database on first start.
TEST_DATABASE_URL=postgresql+asyncpg://nutrition:nutrition@localhost:5432/nutrition_test

# Deployment environment: dev | test | prod. Outside dev the session cookie is Secure-only.
# In prod the app refuses to start without SESSION_SECRET and OPENROUTER_API_KEY.
APP_ENV=dev

# --- Production hardening (Day 7) -----------------------------------------------
# Origins allowed to make credentialed cross-origin requests, comma-separated. Leave
# empty (the default): the browser reaches the API through the Next.js same-origin
# /api rewrite, so no cross-origin access is needed. Never '*'.
# ALLOWED_ORIGINS=
# Per-client requests per minute on the routes that call the model (/api/ask and
# /api/chat together) and on the credential routes (register, login). 0 disables.
# RATE_LIMIT_MODEL_PER_MINUTE=30
# RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Food-table administration --------------------------------------------------
# Emails of the accounts allowed to edit the food table (create, edit, deactivate,
# import), comma-separated, compared case-insensitively. Empty grants nobody the role;
# there is no route that grants it. Writes are rate-limited per client per minute.
# ADMIN_EMAILS=
# RATE_LIMIT_ADMIN_PER_MINUTE=30

# --- Authentication (Day 6) ---------------------------------------------------
# Signs session tokens; at least 32 characters. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it signs every user out. Without it every authenticated route returns 503.
SESSION_SECRET=

# How long a sign-in lasts, in hours (default: 7 days).
# SESSION_TTL_HOURS=168

# --- Logging (Day 6) ------------------------------------------------------------
# One JSON object per line (default; for deployed instances) or readable text.
LOG_FORMAT=text
# Minimum level: DEBUG | INFO | WARNING | ERROR (default INFO).
# LOG_LEVEL=INFO
# Send the meal-plan / gap-detection audit records to their own JSON-lines file instead
# of the main log (hard rule 8 records may need longer retention).
# AUDIT_LOG_PATH=audit.jsonl

# --- Knowledge base and RAG (Day 3) -------------------------------------------
# OpenRouter API key. Required to embed the corpus (scripts/ingest.py) and to answer
# questions (POST /api/ask). The app still boots without it; /api/ask returns 503.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Chat model used for query translation and answer generation (OpenRouter model id).
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Embedding model (OpenRouter model id). Ingestion and search MUST use the same model;
# the Milvus collection records which one built it and refuses to search with another.
# Changing this means deleting milvus.db and re-running `uv run scripts/ingest.py`.
# EMBEDDING_MODEL=openai/text-embedding-3-small

# Milvus Lite database file (generated by ingestion, gitignored).
# MILVUS_DB_PATH=milvus.db

# Corpus directory holding the Markdown documents and manifest.yaml.
# CORPUS_DIR=knowledge-base

# Cosine-similarity floor below which retrieved passages are discarded. If nothing
# clears it the pipeline returns the fixed no-answer message without calling the model.
# RAG_MIN_SIMILARITY=0.45

# Maximum characters of retrieved context placed in the answer prompt.
# RAG_CONTEXT_CHAR_BUDGET=6000

# --- Evaluation harness (evals/, Day 6) -------------------------------------------
# Judge model for RAGAs metrics (default: the app's OPENROUTER_MODEL). A stronger judge
# reduces self-preference bias; the report header records which was used.
# EVAL_JUDGE_MODEL=openai/gpt-4o-mini
# Service under test.
# EVAL_BASE_URL=http://localhost:8000
